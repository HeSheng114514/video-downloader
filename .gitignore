# ============================================================
#  视频下载器 —— Git 忽略规则
#  仓库只收录源码与文档；运行时依赖由程序首次启动时自动下载
# ============================================================

# ---- 打包产物 ----
build/
dist/
*.spec
.build/
.venv/
venv/

# ---- 运行时自动下载的第三方二进制（体积过大，不纳入仓库）----
#  用户运行 启动.bat 时程序会自动下载到这些目录
bin/
vendor/

# ---- 运行期生成的文件 ----
.cache/
logs/
config.json
*.part
*.log

# ---- 本地约定与凭据（绝不入库）----
发布约定.md
GitHub-Token.txt
*token*.txt

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
